{
  "name": "ce-decky",
  "version": "0.9.27",
  "description": "Decky Loader plugin for managing Cheat Engine tables on SteamOS",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "frontend:fallback": "python scripts/frontend_fallback.py",
    "qa": "python scripts/qa.py",
    "test:backend": "python scripts/qa.py --profile backend",
    "test:frontend": "python scripts/qa.py --profile frontend",
    "verify": "python scripts/verify_repo.py",
    "release:check": "python scripts/check_release.py",
    "package:plugin": "python scripts/package_plugin.py",
    "check": "python scripts/qa.py --profile release"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.12.0",
    "@rollup/rollup-linux-x64-musl": "4.53.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "jsdom": "25.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rollup": "4.53.3",
    "typescript": "5.6.2",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
